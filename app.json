{
  "expo": {
    "name": "Sonicverse",
    "slug": "sonic-verse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sonicverse",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05030F",
    "owner": "punivijay",
    "android": {
      "package": "com.sonicverse",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05030F"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "extra": {
      "eas": {
        "projectId": "9d865923-52f8-4710-9a0b-6789ffcf5439"
      }
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#05030F",
          "image": "./assets/splash-icon.png",
          "imageWidth": 620
        }
      ],
      "expo-audio",
      "expo-asset"
    ]
  }
}
